# Copy to .env and fill in. .env is gitignored.
# Email/password account on kumparan.com (SSO accounts are not supported).
KUMPARAN_EMAIL=
KUMPARAN_PASSWORD=

# Alternative to `npm run auth:save` when Cloudflare Turnstile rejects the automated browser:
# the Cookie request header from a browser where you logged in by hand, in single quotes.
# Used by `npm run auth:import`. Treat it like a password.
KUMPARAN_COOKIE=

# Optional overrides
# KUMPARAN_DESKTOP_URL=https://kumparan.com
# KUMPARAN_MOBILE_URL=https://m.kumparan.com
# AUTH_CHANNEL=chrome   # use installed Google Chrome for `npm run auth:save` if Turnstile keeps failing in Playwright's Chromium
